generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Goal {
  id            String      @id @default(uuid())
  publicSlug    String      @unique
  title         String
  description   String?
  category      String?
  status        String      @default("ACTIVE")
  isPublic      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  currentStreak   Int         @default(0)
  longestStreak   Int         @default(0)
  lastLogDateText String?
  entries         LogEntry[]
  patina          GoalPatina?
  automation      ArchiveAutomation?
}

model LogEntry {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  content   String?
  createdAt DateTime @default(now())
  patina    LogEntryPatina?
}

model GoalPatina {
  goalId      String   @id
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  readCount   Int      @default(0)
  patinaScore Float    @default(0.0)
}

model LogEntryPatina {
  entryId     String   @id
  entry       LogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  readCount   Int      @default(0)
  patinaScore Float    @default(0.0)
}

// Secure 1-to-1 table for per-tracker programmatic access (Command Line Access feature).
// Raw keys are NEVER stored. Only the SHA-256 hash and metadata live here.
model ArchiveAutomation {
  goalId       String    @id
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  hashedKey    String?   @unique
  keyPrefix    String?                      // e.g. "pa_live_4f9a" — safe to display
  isEnabled    Boolean   @default(false)
  requestCount Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
}
